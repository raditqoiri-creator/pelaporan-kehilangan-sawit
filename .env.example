# Salin file ini menjadi .env.local lalu sesuaikan sebelum deploy ke produksi

# Connection string Postgres dari Supabase. Ambil dari:
# Supabase Dashboard -> Project -> Connect -> pilih "Transaction pooler"
# (WAJIB pakai pooler/port 6543, bukan direct connection, untuk lingkungan
# serverless seperti Vercel). Tempel URI-nya di sini, ganti [YOUR-PASSWORD]
# dengan password database yang kamu buat.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# Project URL & Service Role Key Supabase. Ambil dari:
# Supabase Dashboard -> Project Settings -> API
# PENTING: SUPABASE_SERVICE_ROLE_KEY punya akses penuh (bypass RLS) — jangan
# pernah dipakai di sisi client/browser, hanya untuk server (sudah sesuai
# karena hanya dipakai di lib/files.js yang berjalan di server).
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Nama bucket Storage tempat foto & tanda tangan disimpan (buat manual di
# Supabase Dashboard -> Storage -> New bucket, set sebagai "Public bucket").
SUPABASE_STORAGE_BUCKET=lapor-kehilangan-sawit

# Kunci rahasia untuk menandatangani sesi login admin (WAJIB diganti, string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Akun admin default yang dibuat otomatis saat pertama kali dijalankan
# (hanya dipakai jika database belum punya akun admin sama sekali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gantiPasswordIni123
